# Copy to .env (git-ignored) for local development, or set these as real
# environment variables / Render dashboard secrets in production.

# --- General ---
PORT=10000
CONFIDENCE_THRESHOLD=0.70
WORD_CONFIDENCE_THRESHOLD=0.30

# --- Emergency SMS/voice-call dispatch (Twilio) ---
# All four of these must be set for POST /api/emergency/alert to place a
# real SMS + voice call. Leave them unset to keep it a logged-only
# prototype (the default). Get the first three from the Twilio console
# (https://console.twilio.com); TWILIO_FROM_NUMBER must be a phone number
# you own on Twilio, and TWILIO_ALERT_TO_NUMBER is the fixed emergency
# contact that should receive every alert, in E.164 format (e.g. +15551234567).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ALERT_TO_NUMBER=

# Optional: disable one channel while keeping the other (default: both true).
# TWILIO_ENABLE_SMS=true
# TWILIO_ENABLE_CALL=true
