# ISL Gesture Recognition System - Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
# Generate a unique value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_ENV=development

# Camera Configuration (optional)
# CAMERA_INDEX=0

# Model Configuration (optional)
# CONFIDENCE_THRESHOLD=0.6

# Emergency alert webhook (keep URL and token private)
WEBHOOK_URL=
WEBHOOK_TOKEN=
